# ── Dependencias (en cualquier carpeta) ──
node_modules/
__pycache__/
venv/
.venv/

# ── Variables de entorno (las plantillas .env.example SÍ se versionan) ──
.env
.env.*
!.env.example

# ── Build ──
dist/
build/

# ── Modelo IA: se ignoran los .pkl excepto el modelo de producción (lo necesita Render) ──
*.pkl
!microservicio-ia/model/modelo_riesgo.pkl

# ── Datos pesados de entrenamiento (27 MB) ──
microservicio-ia/data/*.csv

# ── Logs y temporales ──
*.log
logs/
NUL
*.tmp
temp-qr/

# ── Scripts locales de prueba/diagnóstico (pueden contener tokens o datos reales) ──
backend/test_*.js
backend/verify_endpoint.js
backend/check_teacher.js
backend/diagnostico.js
backend/fix_estudiantes.js

# ── Dependencias instaladas por error en la raíz del proyecto ──
/package.json
/package-lock.json

# ── Sistema / editor ──
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# ── Archivos privados del proyecto ──
AGENTS.md

# Copias de seguridad de la base de datos (contienen datos personales)
respaldos/
backend/respaldos/

# Registros oficiales con datos reales de estudiantes (menores): NUNCA subir
microservicio-ia/dataset_original/

# Archivos temporales de Office (se crean al abrir un documento)
~$*
