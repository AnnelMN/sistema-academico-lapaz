# development en tu computadora; production en Railway (el servidor no arranca
# en producción si falta configuración o hay valores inseguros)
NODE_ENV="development"

# Pooler de Supabase en MODO SESIÓN (puerto 5432): cada consulta ~70 ms frente a ~390 ms del
# modo transacción (6543 + pgbouncer=true), medido el 2026-11-23. connection_limit evita agotar
# el pool de sesiones del plan gratuito.
DATABASE_URL="postgresql://usuario:password@host:5432/postgres?sslmode=require&connection_limit=5"
DIRECT_URL="postgresql://usuario:password@host:5432/postgres?sslmode=require"
# Mínimo 64 caracteres aleatorios en producción
JWT_SECRET="cambia_esto_por_una_clave_larga_y_segura"

# Clave para cifrar los secretos 2FA en la base de datos: 64 caracteres hexadecimales.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Usa la MISMA en todos los entornos que compartan la base de datos y guárdala
#    en un lugar seguro: si se pierde, todos deberán volver a configurar su 2FA.
TOTP_ENC_KEY="cambia_esto_por_64_caracteres_hexadecimales"
JWT_EXPIRES_IN="8h"

INITIAL_DIRECTOR_EMAIL="director@example.com"
INITIAL_DIRECTOR_PASSWORD="cambia_esto_por_una_clave_segura"
INITIAL_DIRECTOR_NAME="Nombre del Director"

SEED_DEMO_DATA=false
DEMO_ADMINISTRATIVO_EMAIL="demo-admin@yopmail.com"
DEMO_ADMINISTRATIVO_PASSWORD="cambia_esto_por_una_clave_segura"
DEMO_ADMINISTRATIVO_NAME="Administrativo Demo"
DEMO_PROFESOR_EMAIL="demo-profesor@yopmail.com"
DEMO_PROFESOR_PASSWORD="cambia_esto_por_una_clave_segura"
DEMO_PROFESOR_NAME="Profesor Demo"
DEMO_ESTUDIANTE_EMAIL="demo-estudiante@yopmail.com"
DEMO_ESTUDIANTE_PASSWORD="cambia_esto_por_una_clave_segura"
DEMO_ESTUDIANTE_NAME="Estudiante Demo"
DEMO_TUTOR_EMAIL="demo-tutor@yopmail.com"

IA_SERVICE_URL="http://localhost:8000"
# Predicción automática de riesgo: false hasta contar con un modelo válido para el colegio
IA_HABILITADA="false"
# Fecha (AAAA-MM-DD) desde la que valen las predicciones del modelo vigente; las anteriores se ignoran
IA_MODELO_DESDE="2026-11-21"
# Clave compartida con el microservicio de IA (igual a IA_API_KEY en microservicio-ia/.env)
IA_API_KEY="cambia_esto_por_una_clave_aleatoria_de_64_caracteres"
# Clave del QR dinámico de asistencia (64 caracteres aleatorios). Sin ella, el registro por QR se desactiva.
QR_SECRET="cambia_esto_por_una_clave_aleatoria_de_64_caracteres"
EMAIL_USER="tu_correo@gmail.com"
EMAIL_PASS="tu_app_password_de_gmail"
FRONTEND_URL="http://localhost:5173"
