generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Rol {
  DIRECTOR
  PROFESOR
  ADMINISTRATIVO
  ESTUDIANTE
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}

enum NivelRiesgo {
  SIN_RIESGO
  RIESGO_MEDIO
  RIESGO_ALTO
}

enum TipoNotificacion {
  RIESGO_ALTO
  EXCESO_FALTAS
}

// Dimensiones que se califican por casillas (la AUTOEVALUACIÓN es un solo valor en Nota)
enum Dimension {
  SER
  SABER
  HACER
}

// ─────────────────────────────────────────────
// TABLA 1: Usuario
// ─────────────────────────────────────────────
model Usuario {
  id            String   @id @default(uuid())
  nombre        String
  email         String   @unique
  password      String
  rol           Rol
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // --- 2FA TOTP (Google Authenticator) ---
  // twoFactorSecret se guarda CIFRADO (AES-256-GCM, ver src/lib/cifrado.js)
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  // Versión de sesión: al cambiarla, todos los tokens anteriores dejan de valer
  // (cambio de contraseña, de rol, desactivación o "cerrar todas las sesiones")
  tokenVersion Int @default(0)

  estudiante Estudiante?
  docente    Docente?

  codigosVerificacion CodigoVerificacion[]

  @@map("usuarios")
}

// ─────────────────────────────────────────────
// TABLA 2: Estudiante
// ─────────────────────────────────────────────
model Estudiante {
  id         String  @id @default(uuid())
  usuarioId  String  @unique
  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cursoId    String
  curso      Curso   @relation(fields: [cursoId], references: [id])
  gestion    Int
  emailTutor String

  notas          Nota[]
  asistencias    Asistencia[]
  predicciones   PrediccionRiesgo[]
  notificaciones Notificacion[]
  calificaciones CalificacionCasilla[]

  @@map("estudiantes")
}

// ─────────────────────────────────────────────
// TABLA 3: Docente
// ─────────────────────────────────────────────
model Docente {
  id           String  @id @default(uuid())
  usuarioId    String  @unique
  usuario      Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  especialidad String

  materias MateriaProgramada[]

  @@map("docentes")
}

// ─────────────────────────────────────────────
// TABLA 4: Curso
// ─────────────────────────────────────────────
model Curso {
  id       String @id @default(uuid())
  nivel    Int
  paralelo String

  estudiantes Estudiante[]
  horarios    MateriaProgramada[]

  @@unique([nivel, paralelo])
  @@map("cursos")
}

// ─────────────────────────────────────────────
// TABLA 5: Materia
// ─────────────────────────────────────────────
model Materia {
  id           String @id @default(uuid())
  nombre       String
  cargaHoraria Int
  nivel        Int

  programaciones MateriaProgramada[]

  @@map("materias")
}

// ─────────────────────────────────────────────
// TABLA 6: MateriaProgramada
// ─────────────────────────────────────────────
model MateriaProgramada {
  id        String  @id @default(uuid())
  materiaId String
  materia   Materia @relation(fields: [materiaId], references: [id])
  docenteId String
  docente   Docente @relation(fields: [docenteId], references: [id])
  cursoId   String
  curso     Curso   @relation(fields: [cursoId], references: [id])
  horario   String
  gestion   Int

  notas       Nota[]
  asistencias Asistencia[]
  casillas    Casilla[]

  @@map("materias_programadas")
}

// ─────────────────────────────────────────────
// TABLA 7: Nota — RESUMEN del trimestre, calculado por el servidor
// SER (0–10) + SABER (0–45) + HACER (0–40) + AUTOEVALUACIÓN (0–5) = total (0–100)
// SER, SABER y HACER salen del promedio de sus casillas, redondeado a entero.
// La autoevaluación la registra el docente (null = aún no registrada).
// ─────────────────────────────────────────────
model Nota {
  id                  String            @id @default(uuid())
  estudianteId        String
  estudiante          Estudiante        @relation(fields: [estudianteId], references: [id])
  materiaProgramadaId String
  materiaProgramada   MateriaProgramada @relation(fields: [materiaProgramadaId], references: [id])
  trimestre           Int
  ser                 Int
  saber               Int
  hacer               Int
  autoevaluacion      Int?
  total               Int
  aprobado            Boolean
  creadoEn            DateTime          @default(now())
  actualizadoEn       DateTime          @updatedAt

  @@unique([estudianteId, materiaProgramadaId, trimestre])
  @@map("notas")
}

// ─────────────────────────────────────────────
// TABLA 8: Asistencia
// ─────────────────────────────────────────────
model Asistencia {
  id                  String            @id @default(uuid())
  estudianteId        String
  estudiante          Estudiante        @relation(fields: [estudianteId], references: [id])
  materiaProgramadaId String
  materiaProgramada   MateriaProgramada @relation(fields: [materiaProgramadaId], references: [id])
  fecha               DateTime
  estado              EstadoAsistencia
  creadoEn            DateTime          @default(now())

  @@unique([estudianteId, materiaProgramadaId, fecha])
  @@map("asistencias")
}

// ─────────────────────────────────────────────
// TABLA 9a: PrediccionRiesgo
// ─────────────────────────────────────────────
model PrediccionRiesgo {
  id                   String      @id @default(uuid())
  estudianteId         String
  estudiante           Estudiante  @relation(fields: [estudianteId], references: [id])
  nivelRiesgo          NivelRiesgo
  probabilidad         Float
  promedioNotas        Float
  porcentajeAsistencia Float
  trimestre            Int
  generadoEn           DateTime    @default(now())

  @@map("predicciones_riesgo")
}

// ─────────────────────────────────────────────
// TABLA 9b: Notificacion
// ─────────────────────────────────────────────
model Notificacion {
  id           String           @id @default(uuid())
  estudianteId String
  estudiante   Estudiante       @relation(fields: [estudianteId], references: [id])
  tipo         TipoNotificacion
  emailDestino String
  estadoEnvio  String
  mensaje      String?
  enviadoEn    DateTime         @default(now())

  @@map("notificaciones")
}

// ─────────────────────────────────────────────
// TABLA NUEVA: Casilla — columnas que el docente define por materia,
// trimestre y dimensión (máximo 20 por dimensión). En SER, una casilla es
// siempre la de asistencia (esAsistencia = true): su valor no se guarda,
// se calcula con los registros de asistencia de esa materia y trimestre.
// ─────────────────────────────────────────────
model Casilla {
  id                  String            @id @default(uuid())
  materiaProgramadaId String
  materiaProgramada   MateriaProgramada @relation(fields: [materiaProgramadaId], references: [id])
  trimestre           Int
  dimension           Dimension
  orden               Int
  nombre              String?
  esAsistencia        Boolean           @default(false)
  creadoEn            DateTime          @default(now())
  actualizadoEn       DateTime          @updatedAt

  calificaciones CalificacionCasilla[]

  @@unique([materiaProgramadaId, trimestre, dimension, orden])
  @@index([materiaProgramadaId, trimestre])
  @@map("casillas")
}

// ─────────────────────────────────────────────
// TABLA NUEVA: CalificacionCasilla — nota (entero 0–100) de un estudiante
// en una casilla. Si se elimina la casilla, se eliminan sus notas.
// ─────────────────────────────────────────────
model CalificacionCasilla {
  id              String     @id @default(uuid())
  casillaId       String
  casilla         Casilla    @relation(fields: [casillaId], references: [id], onDelete: Cascade)
  estudianteId    String
  estudiante      Estudiante @relation(fields: [estudianteId], references: [id])
  valor           Int
  registradoPorId String
  creadoEn        DateTime   @default(now())
  actualizadoEn   DateTime   @updatedAt

  @@unique([casillaId, estudianteId])
  @@index([estudianteId])
  @@map("calificaciones_casilla")
}

// ─────────────────────────────────────────────
// TABLA NUEVA: PeriodoTrimestral — fechas de cada trimestre por gestión,
// configuradas por el Director. Definen el trimestre de cada asistencia
// (por su fecha) y cuál es el trimestre activo (el que contiene la fecha de hoy).
// ─────────────────────────────────────────────
model PeriodoTrimestral {
  id            String   @id @default(uuid())
  gestion       Int
  trimestre     Int
  fechaInicio   DateTime @db.Date
  fechaFin      DateTime @db.Date
  actualizadoEn DateTime @updatedAt

  @@unique([gestion, trimestre])
  @@map("periodos_trimestrales")
}

// ─────────────────────────────────────────────
// TABLA EXTRA: Configuracion
// ─────────────────────────────────────────────
model Configuracion {
  id               String   @id @default(uuid())
  limiteFaltas     Int      @default(25)
  umbralAprobacion Int      @default(51)
  trimestreActivo  Int      @default(1)
  gestionActual    Int      @default(2026)
  actualizadoEn    DateTime @updatedAt

  @@map("configuracion")
}

// ─────────────────────────────────────────────
// TABLA EXTRA: CodigoVerificacion (OTP por correo)
// Un solo uso, expira en 5 minutos. El código se guarda
// como hash SHA-256, nunca en texto plano.
// ─────────────────────────────────────────────
model CodigoVerificacion {
  id         String   @id @default(uuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String
  expiraEn   DateTime
  intentos   Int      @default(0)
  usado      Boolean  @default(false)
  creadoEn   DateTime @default(now())

  @@index([usuarioId, usado])
  @@map("codigos_verificacion")
}

// ─────────────────────────────────────────────
// TABLA NUEVA: AuditoriaCambio — historial de cambios en notas y asistencia
// (quién cambió qué, cuándo, valor anterior y nuevo). Solo lo consulta el
// Director; nadie puede editarlo ni borrarlo desde la API.
// ─────────────────────────────────────────────
model AuditoriaCambio {
  id                  String   @id @default(uuid())
  entidad             String
  accion              String
  entidadId           String?
  materiaProgramadaId String?
  estudianteId        String?
  valorAnterior       Json?
  valorNuevo          Json?
  usuarioId           String
  creadoEn            DateTime @default(now())

  @@index([creadoEn])
  @@index([materiaProgramadaId])
  @@index([estudianteId])
  @@map("auditoria_cambios")
}
