MODEL_PATH=./model/modelo_riesgo.pkl

# development habilita /docs en tu computadora; en Render NO definirla (o usar production)
ENTORNO=development

# Clave compartida con el backend (debe ser IGUAL a IA_API_KEY en backend/.env).
# Genera una aleatoria de 64 caracteres, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IA_API_KEY=cambia_esto_por_una_clave_aleatoria_de_64_caracteres
